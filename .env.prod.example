# Runtime configuration for docker-compose.prod.yml.
# Copy to .env on the server. Never commit the filled-in version.

# --- images ------------------------------------------------------------------
OCI_REGISTRY=ocir.eu-frankfurt-1.oci.oraclecloud.com
OCI_NAMESPACE=
# The tag scripts/push-oci.sh printed — a git sha beats :latest, because six
# weeks from now :latest tells you nothing about what is actually running.
IMAGE_TAG=latest

# --- public URLs -------------------------------------------------------------
# Must match the redirect URIs baked into the realm by make-prod-realm.mjs.
WEB_ORIGIN=https://learn.example.com
KEYCLOAK_PUBLIC_URL=https://auth.example.com

# --- secrets -----------------------------------------------------------------
# Generate each with: openssl rand -base64 32
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
KEYCLOAK_DB_PASSWORD=
RATE_LIMIT_PEPPER=

# First boot only. Create a real admin, then delete these and redeploy.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=

# Keycloak generates this on first realm import — it is deliberately NOT in the
# image. Read it back with scripts/read-client-secrets.sh, then fill it in and
# restart the api service.
KEYCLOAK_ADMIN_CLIENT_SECRET=

# The address your load balancer or reverse proxy connects from. Leave empty if
# the API is reached directly — otherwise any client could forge the IP that the
# rate limiter and the export audit log record.
TRUSTED_PROXIES=

# --- malware scanning ---------------------------------------------------------
CLAMAV_ENABLED=true
CLAMAV_TIMEOUT=600

# --- web ----------------------------------------------------------------------
# The youlearn-web client secret Keycloak generated on first realm import. Read
# it with scripts/read-client-secrets.sh.
KEYCLOAK_CLIENT_SECRET=

# Encrypts the session cookie. At least 32 characters. Rotating it signs
# everybody out, which is the intended blast radius: this key is the only thing
# between a stolen cookie and a usable refresh token.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- logs ---------------------------------------------------------------------
# How long VictoriaLogs keeps a line. Everything the containers write lands
# here; the boot volume also holds every uploaded video, so this is a disk
# budget, not a preference.
LOGS_RETENTION=90d

# What the log UI listens on. 127.0.0.1 means "reachable only through an SSH
# tunnel", which is the intended setting:
#
#   ssh -L 9428:127.0.0.1:9428 <instance>
#   open http://127.0.0.1:9428/select/vmui
#
# vmui has no login of its own. Setting this to 0.0.0.0 publishes every log
# this platform produces to anyone who finds the port.
LOGS_BIND=127.0.0.1

# --- image names (defaults are fine unless your repositories differ) -----------
KEYCLOAK_REPO=youlearnkeycloak
API_REPO=youlearnapi
WEB_REPO=youlearnweb

# --- base images --------------------------------------------------------------
# The public images this stack runs alongside its own. They default to
# Docker Hub, which routes badly from af-casablanca-1 — pulls fail there with
# `TLS handshake timeout` often enough to break a deploy.
#
# Run the "Mirror base images" workflow once, then point these at the OCIR
# copies. That removes Docker Hub from the runtime path entirely; the same
# registry that serves the application images serves these, in the same region.
#
# CADDY_IMAGE=<registry>/<namespace>/youlearnbase:caddy-2-alpine
# POSTGRES_IMAGE=<registry>/<namespace>/youlearnbase:postgres-16-alpine
# MYSQL_IMAGE=<registry>/<namespace>/youlearnbase:mysql-8.4
# CLAMAV_IMAGE=<registry>/<namespace>/youlearnbase:clamav-1.4
# VICTORIALOGS_IMAGE=<registry>/<namespace>/youlearnbase:victoria-logs-1.52.0
# VECTOR_IMAGE=<registry>/<namespace>/youlearnbase:vector-0.57.0-alpine
