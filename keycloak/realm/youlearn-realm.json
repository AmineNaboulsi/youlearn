    },
    {
      "username": "teacher@youlearn.local",
      "email": "teacher@youlearn.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Nora",
      "lastName": "Benali",
      "credentials": [
        {
          "type": "password",
          "value": "Teacher#2026pass",
          "temporary": false
        }
      ],
      "realmRoles": [
        "enseignant",
        "offline_access",
        "uma_authorization"
      ],
      "id": "22222222-2222-4222-8222-222222222222"
    },
    {
      "username": "student@youlearn.local",
      "email": "student@youlearn.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Yassine",
      "lastName": "Rahmani",
      "credentials": [
        {
          "type": "password",
          "value": "Student#2026pass",
          "temporary": false
        }
      ],
      "realmRoles": [
        "etudiant",
        "offline_access",
        "uma_authorization"
      ],
      "id": "33333333-3333-4333-8333-333333333333"
    },
    {
      "username": "service-account-youlearn-admin",
      "enabled": true,
      "serviceAccountClientId": "youlearn-admin",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "query-users",
          "query-groups",
          "manage-users",
          "view-events"
        ]
      }
    }
  ],
  "browserSecurityHeaders": {
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self'; object-src 'none';",
    "xFrameOptions": "SAMEORIGIN",
    "xContentTypeOptions": "nosniff",
    "referrerPolicy": "no-referrer",
    "strictTransportSecurity": "max-age=31536000; includeSubDomains",
    "xRobotsTag": "none"
  },
  "internationalizationEnabled": false,
  "supportedLocales": [
    "en"
  ],
  "defaultLocale": "en"
}
