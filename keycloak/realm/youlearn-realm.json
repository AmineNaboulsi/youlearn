{
  "realm": "youlearn",
  "displayName": "YouLearn",
  "displayNameHtml": "<span style=\"font-weight:600;letter-spacing:-0.02em\">YouLearn</span>",
  "enabled": true,
  "loginTheme": "youlearn",
  "accountTheme": "keycloak.v3",
  "adminTheme": "keycloak.v2",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "sslRequired": "external",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "ssoSessionIdleTimeoutRememberMe": 172800,
  "ssoSessionMaxLifespanRememberMe": 604800,
  "offlineSessionIdleTimeout": 2592000,
  "clientSessionIdleTimeout": 0,
  "clientSessionMaxLifespan": 0,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "passwordPolicy": "length(10) and notUsername(undefined) and notEmail(undefined) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1) and passwordHistory(3)",
  "eventsEnabled": true,
  "eventsExpiration": 604800,
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "REGISTER",
    "REGISTER_ERROR",
    "REFRESH_TOKEN",
    "REFRESH_TOKEN_ERROR",
    "CODE_TO_TOKEN",
    "CODE_TO_TOKEN_ERROR",
    "UPDATE_PASSWORD",
    "REMOVE_TOTP",
    "UPDATE_TOTP",
    "REVOKE_GRANT",
    "DELETE_ACCOUNT"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Platform administrator. Full access to every course, user and export.",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "enseignant",
        "description": "Instructor. Authors and manages their own courses, exports their own enrolments.",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "etudiant",
        "description": "Student. Browses and enrols in courses.",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "defaultRoles": [
    "offline_access",
    "uma_authorization",
    "etudiant"
  ],
  "requiredCredentials": [
    "password"
  ],
  "clients": [
    {
      "clientId": "youlearn-web",
      "name": "YouLearn Web (Next.js)",
      "description": "Server-side rendered Next.js front end. Authorization Code + PKCE, confidential.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "secret": "youlearn-web-secret-change-me",
      "rootUrl": "http://localhost:3100",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:3100/api/auth/callback",
        "http://localhost:3100/api/auth/callback/*"
      ],
      "webOrigins": [
        "http://localhost:3100"
      ],
      "adminUrl": "http://localhost:3100",
      "frontchannelLogout": true,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3100/*",
        "access.token.lifespan": "300",
        "client.session.idle.timeout": "1800",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "true",
        "oauth2.device.authorization.grant.enabled": "false",
        "use.refresh.tokens": "true",
        "require.pushed.authorization.requests": "false",
        "tls.client.certificate.bound.access.tokens": "false"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "organization"
      ],
      "protocolMappers": [
        {
          "name": "youlearn-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "youlearn-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "realm-roles-flat",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "youlearn-api",
      "name": "YouLearn API (PHP resource server)",
      "description": "Bearer-only resource server. Never initiates a login; only validates access tokens.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "secret": "youlearn-api-secret-change-me",
      "attributes": {
        "backchannel.logout.session.required": "true"
      }
    },
    {
      "clientId": "youlearn-admin",
      "name": "YouLearn Admin (backend service account)",
      "description": "Client-credentials only. Used by the PHP backend to reach the Keycloak Admin REST API for user and session administration. Never exposed to a browser.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "youlearn-admin-secret-change-me",
      "attributes": {
        "access.token.lifespan": "300",
        "use.refresh.tokens": "false"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "basic"
      ],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "admin@youlearn.local",
      "email": "admin@youlearn.local",
      "emailVerified": true,
