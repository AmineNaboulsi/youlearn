# Oracle Cloud Infrastructure Registry — used by scripts/push-oci.sh.
# Copy to .env.deploy (git-ignored) and fill in.

# Registry endpoint for your region. Two formats both work:
#   ocir.<region-identifier>.oci.oraclecloud.com   (current, documented)
#   <region-key>.ocir.io                           (older, still valid)
# Examples: ocir.eu-frankfurt-1.oci.oraclecloud.com | fra.ocir.io
#           ocir.us-ashburn-1.oci.oraclecloud.com   | iad.ocir.io
OCI_REGISTRY=ocir.eu-frankfurt-1.oci.oraclecloud.com

# Repository names EXACTLY as they appear in the OCIR console. A name with a
# slash is a different repository from one without, and pushing to a name that
# does not exist silently creates it — leaving the one you made sitting empty.
KEYCLOAK_REPO=youlearn/keycloak
API_REPO=youlearn/api

# Tenancy OBJECT STORAGE namespace — not the tenancy name.
# Console: Profile menu -> Tenancy. Or: oci os ns get
OCI_NAMESPACE=

# Your console username. Federated (IDCS/Identity Domain) users must include
# the prefix, or the login is rejected with an unhelpful 401:
#   plain      jdoe@example.com
#   federated  oracleidentitycloudservice/jdoe@example.com
OCI_USER=

# An AUTH TOKEN, not your console password.
# Console: Profile -> My profile -> Tokens and keys -> Auth tokens -> Generate.
# It is shown once. Leave this blank to use an existing `docker login` instead.
OCI_AUTH_TOKEN=

# Target architecture. Always Free (VM.Standard.A1.Flex) is Ampere = arm64.
# E3/E4/E5 shapes are amd64. Use both for a multi-arch manifest.
#   linux/arm64 | linux/amd64 | linux/amd64,linux/arm64
PLATFORM=linux/arm64
