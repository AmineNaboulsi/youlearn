# YouLearn web — server-side configuration.
#
# None of these are NEXT_PUBLIC_. The client secret and the session key must
# never reach a browser bundle, and `src/lib/env.ts` is marked server-only so
# importing it from a client component fails the build rather than leaking.

# Where this app is reachable. Used to build the OIDC redirect URI, so it must
# match the redirect registered on the Keycloak client exactly.
APP_URL=http://localhost:3100

# The YouLearn API, as seen from the Next.js server. The browser never calls it
# directly — every request is made server-side so the access token stays here.
API_URL=http://localhost:8000

# Realm issuer exactly as it appears in the `iss` claim. The browser is sent to
# this host to sign in, so it must be the public URL.
KEYCLOAK_ISSUER=http://localhost:8080/realms/youlearn

# Issuer used for server-to-server calls (token exchange, refresh, JWKS).
# Only differs from the above when this app runs inside Docker and reaches
# Keycloak on the container network. Leave unset to reuse KEYCLOAK_ISSUER.
KEYCLOAK_ISSUER_INTERNAL=http://localhost:8080/realms/youlearn

KEYCLOAK_CLIENT_ID=youlearn-web
KEYCLOAK_CLIENT_SECRET=youlearn-web-secret-change-me

# Key for the encrypted (A256GCM) session cookie — at least 32 characters.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating it signs everybody out, which is the intended blast radius: this key
# is all that stands between a stolen cookie and a usable refresh token.
SESSION_SECRET=
