# TLS termination for both hostnames.
#
# Caddy obtains and renews Let's Encrypt certificates on its own. The only
# prerequisites are that each name already resolves to this instance and that
# ports 80 and 443 are open in BOTH the OCI security list and the instance's
# iptables — the second one catches almost everybody.

# Global options. Must be the first block in the file.
{
	# Caddy's admin API — the thing that can rewrite this proxy's entire
	# configuration at runtime, including which upstream each hostname points
	# at. It defaults to localhost:2019, which is the *container's* loopback:
	# unreachable from the internet, from a sibling container, and from the
	# host, which is why an SSH tunnel to the host's 127.0.0.1:2019 arrives at
	# nothing. It was never exposed.
	#
	# Bound to 0.0.0.0 here so that Docker can forward a port to it, and then
	# published as 127.0.0.1:2019 on the host only — see the proxy service in
	# docker-compose.prod.yml. The reachable surface is therefore the host's
	# loopback and nothing else: no security-list rule, no iptables change, no
	# port open to any network. The way in is
	#
	#   ssh -L 2019:127.0.0.1:2019 ubuntu@<instance>
	#
	# which works from whatever address you happen to be on, and needs no
	# allow-list to follow you around.
	#
	# `origins` is not optional once the listener is off loopback: Caddy
	# refuses requests whose Host header is not in this list, and the tunnel
	# presents 127.0.0.1:2019. Listing it explicitly also means that publishing
	# this port more widely takes two deliberate changes rather than one.
	#
	# This API has no authentication and no UI. It is a JSON REST endpoint —
	# GET /config/ returns the running configuration — and anything that can
	# reach it can repoint both hostnames, so the loopback bind is the whole
	# of the access control.
	admin 0.0.0.0:2019 {
		origins 127.0.0.1:2019 localhost:2019
	}
}

# Access logs are off in Caddy unless a site asks for them, and this stack ran
# without any: the first hop a request makes recorded nothing about it, so the
# caller's address for an upload the scanner refused was simply not written
# down anywhere. `log` with no body means JSON to stdout, which is where the
# collector picks it up — see "Reading the logs" in infra/README.md.
{$KEYCLOAK_PUBLIC_URL} {
	log

	reverse_proxy {
		# Re-resolve rather than trusting the address found at startup.
		#
		# Every deploy recreates this container with a new IP, and a static
		# upstream is resolved once when Caddy loads its config. Worse, if the
		# upstream does not exist yet at that moment — which is exactly the case
		# on a first bring-up — the lookup fails and Caddy keeps serving 502
		# from that failure indefinitely, long after the container is healthy.
		dynamic a {
			name keycloak
			port 8080
			refresh 10s
		}

		# Keycloak builds its redirect URLs from these; without them it emits
		# http:// links behind an https:// proxy and the login loops forever.
		# Caddy sets all three itself and warns that they are redundant — kept
		# explicit because a silent default is a poor thing to depend on for
		# that difference.
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-For {remote_host}
	}
}

{$WEB_ORIGIN} {
	log

	# The Next.js app — the `web` service in docker-compose.prod.yml.
	reverse_proxy {
		# See the note above: `web` is recreated on every deploy, and Caddy
		# cached a failed lookup from before it existed.
		dynamic a {
			name web
			port 3000
			refresh 10s
		}

		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
	}

	# The API is reached server-side by Next.js over the internal network, so it
	# deliberately has no public route. Nothing outside this host can call it
	# directly, which is what keeps every request permission-checked in one place.
}
