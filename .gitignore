
# Deployment configuration — contains an OCIR auth token.
.env.deploy

# Generated by scripts/make-prod-realm.mjs at build time.
keycloak/realm-prod/

# Filled-in production runtime config.
.env.prod

# Terraform state and variables hold database passwords in clear text.
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/terraform.tfvars
infra/.terraform.lock.hcl
infra/tfplan

# Any .env anywhere holds real credentials — database passwords, auth tokens,
# session keys. Ignore them all and allow only the *.example templates back in,
# rather than listing paths one at a time and eventually missing one.
.env
.env.*
**/.env
**/.env.*
!*.example
!**/*.example

# Standalone spike, kept beside the project but not part of it. It carries
# its own Firebase service-account material, which must never reach a commit.
firebase-sms/
