{
    "name": "youlearn/api",
    "description": "YouLearn API — an OAuth2 resource server for the YouLearn platform. Validates Keycloak-issued access tokens and enforces the platform's permission model.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "AmineNaboulsi",
            "email": "naboulsiiamine@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-curl": "*",
        "ext-openssl": "*",
        "firebase/php-jwt": "^7.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
