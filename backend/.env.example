# YouLearn API configuration.
#
# Under docker compose every value below is supplied as a real environment
# variable, and this file is not read at all. Copy it to .env only when running
# the API directly against a local PHP.
#
# There is no JWT secret here any more: this service does not mint tokens. It
# verifies Keycloak's RS256 signatures against the realm's public JWKS, so
# there is nothing to keep secret on the signing side.

APP_ENV=local

# --- Database ----------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=youlearn
DB_USER=youlearn
DB_PASS=youlearn

# --- Keycloak ----------------------------------------------------------------
# INTERNAL is how this service reaches Keycloak (container network).
# PUBLIC is how the browser reaches it. Tokens carry whichever issued them, so
# the verifier accepts both and nothing else.
KEYCLOAK_INTERNAL_URL=http://localhost:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM=youlearn

# Access tokens must name this API in `aud` (or `azp`). Without this check, a
# token minted for any other client in the realm would be accepted here.
KEYCLOAK_AUDIENCE=youlearn-api

# Service account for the Admin REST API — suspending accounts, changing roles,
# listing and revoking sessions. Scoped to view-users/manage-users only.
# Rotate this in any environment that is not a laptop.
KEYCLOAK_ADMIN_CLIENT_ID=youlearn-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=youlearn-admin-secret-change-me

# --- CORS --------------------------------------------------------------------
# Exact origins, comma separated. Never a wildcard: the API answers with
# per-user data and a wildcard would let any site read it on the user's behalf.
ALLOWED_ORIGINS=http://localhost:3100

# --- Rate limiting -----------------------------------------------------------
# Keys the HMAC that fingerprints rate-limit actors, so the counter table holds
# no raw user ids or IP addresses. Changing it resets every live window.
RATE_LIMIT_PEPPER=change-me

# Comma-separated peers whose X-Forwarded-For header may be believed. Leave
# empty when the API is reached directly — otherwise any client could forge the
# address the rate limiter and audit log record.
TRUSTED_PROXIES=
